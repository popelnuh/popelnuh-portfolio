---
interface Props {
	title?: string;
}

const { title = 'Zlata Popelnuh' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav aria-label="Main navigation">
				<a class="brand" href="/">Zlata Popelnuh</a>
				<div class="nav-links">
					<a href="/">Home</a>
					<a href="/about">About</a>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f7f8fc;
		color: #171a24;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
	}

	header {
		border-bottom: 1px solid #e6e8ef;
		background: rgba(255, 255, 255, 0.92);
	}

	nav {
		width: min(100% - 40px, 960px);
		height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		color: #171a24;
		text-decoration: none;
	}

	.brand {
		font-weight: 750;
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		color: #555b6b;
		font-weight: 600;
	}

	.nav-links a:hover {
		color: #635bff;
	}

	main {
		width: min(100% - 40px, 960px);
		margin: 0 auto;
	}
</style>
