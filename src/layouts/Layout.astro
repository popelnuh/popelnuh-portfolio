---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Zlata Popelnuh',
	description = 'Senior Test Automation Engineer & GIS specialist. Interactive European data maps, clean architecture, and Playwright automation.',
} = Astro.props;
const currentPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" data-testid="favicon-link" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} data-testid="description-meta" />
		<meta property="og:title" content={title} data-testid="og-title-meta" />
		<meta property="og:description" content={description} data-testid="og-description-meta" />
		<meta property="og:type" content="website" data-testid="og-type-meta" />
		<meta name="twitter:card" content="summary" data-testid="twitter-card-meta" />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav aria-label="Main navigation">
				<a class="brand" href="/">Zlata Popelnuh</a>
				<div class="nav-links">
					<a
						href="/"
						class={currentPathname === '/' ? 'active' : undefined}
						aria-current={currentPathname === '/' ? 'page' : undefined}
						data-track="nav-home"
						data-testid="nav-home">Home</a
					>
					<a
						href="/about"
						class={currentPathname === '/about' ? 'active' : undefined}
						aria-current={currentPathname === '/about' ? 'page' : undefined}
						data-track="nav-about"
						data-testid="nav-about">About</a
					>
					<a
						href="/maps"
						class={currentPathname === '/maps' ? 'active' : undefined}
						aria-current={currentPathname === '/maps' ? 'page' : undefined}
						data-track="nav-maps"
						data-testid="nav-maps">Maps</a
					>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-content">
				<span>© 2026 Zlata Popelnuh · Built with Astro &amp; tested with </span>
				<a
					class="playwright-link"
					href="https://github.com/popelnuh/popelnuh-portfolio"
					target="_blank"
					rel="noopener noreferrer"
					data-track="footer-playwright-repo"
					data-testid="footer-playwright-repo">Playwright</a
				>
				<div class="actions-badges" data-testid="footer-badges">
					<a
						class="actions-badge"
						href="https://github.com/popelnuh/popelnuh-portfolio/actions/workflows/azure-static-web-apps-salmon-water-0ad7f5510.yml"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="CI/CD workflow status"
						data-track="footer-ci-badge"
						data-testid="footer-ci-badge"
					>
						<img
							src="https://img.shields.io/github/actions/workflow/status/popelnuh/popelnuh-portfolio/azure-static-web-apps-salmon-water-0ad7f5510.yml?branch=main&amp;style=flat-square&amp;label=CI%2FCD&amp;labelColor=0f172a&amp;color=10b981"
							alt="CI/CD status"
							height="20"
						/>
					</a>
					<a
						class="actions-badge"
						href="https://github.com/popelnuh/popelnuh-portfolio/actions/workflows/unit-tests.yml"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Unit tests workflow status"
						data-track="footer-unit-tests-badge"
						data-testid="footer-unit-tests-badge"
					>
						<img
							src="https://img.shields.io/github/actions/workflow/status/popelnuh/popelnuh-portfolio/unit-tests.yml?branch=main&amp;style=flat-square&amp;label=Unit%20Tests&amp;labelColor=0f172a&amp;color=10b981"
							alt="Unit tests status"
							height="20"
						/>
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	import { trackEvent } from '../lib/analytics';

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const trackedElement = event.target.closest<HTMLElement>('[data-track]');
		const name = trackedElement?.dataset.track;
		if (!name) return;

		const dataset = trackedElement.dataset.dataset;
		trackEvent(name, dataset ? { dataset } : undefined);
	});
</script>

<style>
	:global(:root) {
		--accent: #1e293b;
		--accent-hover: #0f172a;
		--accent-muted: #475569;
		--accent-soft: #f1f5f9;
		--border-subtle: #e2e8f0;
		--text-primary: #0f172a;
		--text-body: #334155;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f7f8fc;
		color: var(--text-primary);
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	header {
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(255, 255, 255, 0.92);
	}

	nav {
		width: min(100% - 40px, 960px);
		height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.brand {
		font-weight: 750;
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		padding: 8px 0 6px;
		border-bottom: 2px solid transparent;
		color: var(--text-body);
		font-weight: 600;
		transition: color 160ms ease, border-color 160ms ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--accent);
	}

	.nav-links a.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}

	main {
		width: min(100% - 40px, 960px);
		margin: 0 auto;
		flex: 1;
	}

	footer {
		padding: 17px 20px;
		border-top: 1px solid var(--border-subtle);
		color: var(--accent-muted);
		font-size: 0.85rem;
		text-align: center;
	}

	.footer-content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 6px 8px;
	}

	.playwright-link {
		color: inherit;
		text-decoration-color: var(--border-subtle);
		text-underline-offset: 2px;
	}

	.playwright-link:hover {
		color: var(--accent);
	}

	.actions-badges {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 8px;
	}

	.actions-badge {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.actions-badge img {
		display: block;
		width: auto;
		height: 20px;
		max-width: 100%;
	}
</style>
