---
interface Props {
	title?: string;
}

const { title = 'Zlata Popelnuh' } = Astro.props;
const currentPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav aria-label="Main navigation">
				<a class="brand" href="/">Zlata Popelnuh</a>
				<div class="nav-links">
					<a
						href="/"
						class={currentPathname === '/' ? 'active' : undefined}
						aria-current={currentPathname === '/' ? 'page' : undefined}>Home</a
					>
					<a
						href="/about"
						class={currentPathname === '/about' ? 'active' : undefined}
						aria-current={currentPathname === '/about' ? 'page' : undefined}>About</a
					>
					<a
						href="/maps"
						class={currentPathname === '/maps' ? 'active' : undefined}
						aria-current={currentPathname === '/maps' ? 'page' : undefined}>Maps</a
					>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>© 2026 Zlata Popelnuh · Built with Astro &amp; tested with Playwright</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f7f8fc;
		color: #171a24;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	header {
		border-bottom: 1px solid #e6e8ef;
		background: rgba(255, 255, 255, 0.92);
	}

	nav {
		width: min(100% - 40px, 960px);
		height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		color: #171a24;
		text-decoration: none;
	}

	.brand {
		font-weight: 750;
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		padding: 8px 0 6px;
		border-bottom: 2px solid transparent;
		color: #555b6b;
		font-weight: 600;
		transition: color 160ms ease, border-color 160ms ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: #4f46e5;
	}

	.nav-links a.active {
		border-bottom-color: #4f46e5;
		font-weight: 700;
	}

	main {
		width: min(100% - 40px, 960px);
		margin: 0 auto;
		flex: 1;
	}

	footer {
		padding: 17px 20px;
		border-top: 1px solid #e6e8ef;
		color: #64748b;
		font-size: 0.85rem;
		text-align: center;
	}
</style>
