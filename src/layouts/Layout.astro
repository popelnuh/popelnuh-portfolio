---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Zlata Popelnuh',
	description = 'Senior Test Automation Engineer & GIS specialist. Interactive European data maps, clean architecture, and Playwright automation.',
} = Astro.props;
const currentPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav aria-label="Main navigation">
				<a class="brand" href="/">Zlata Popelnuh</a>
				<div class="nav-links">
					<a
						href="/"
						class={currentPathname === '/' ? 'active' : undefined}
						aria-current={currentPathname === '/' ? 'page' : undefined}>Home</a
					>
					<a
						href="/about"
						class={currentPathname === '/about' ? 'active' : undefined}
						aria-current={currentPathname === '/about' ? 'page' : undefined}>About</a
					>
					<a
						href="/maps"
						class={currentPathname === '/maps' ? 'active' : undefined}
						aria-current={currentPathname === '/maps' ? 'page' : undefined}>Maps</a
					>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-content">
				<span>© 2026 Zlata Popelnuh · Built with Astro &amp; tested with </span>
				<a
					class="playwright-link"
					href="https://github.com/popelnuh/popelnuh-portfolio"
					target="_blank"
					rel="noopener noreferrer">Playwright</a
				>
				<a
					class="actions-badge"
					href="https://github.com/popelnuh/popelnuh-portfolio/actions"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub Actions workflow status"
				>
					<img
						src="https://github.com/popelnuh/popelnuh-portfolio/actions/workflows/azure-static-web-apps-salmon-water-0ad7f5510.yml/badge.svg"
						alt="GitHub Actions status"
						height="20"
					/>
				</a>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(:root) {
		--accent: #1e293b;
		--accent-hover: #0f172a;
		--accent-muted: #475569;
		--accent-soft: #f1f5f9;
		--border-subtle: #e2e8f0;
		--text-primary: #0f172a;
		--text-body: #334155;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f7f8fc;
		color: var(--text-primary);
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	header {
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(255, 255, 255, 0.92);
	}

	nav {
		width: min(100% - 40px, 960px);
		height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.brand {
		font-weight: 750;
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		padding: 8px 0 6px;
		border-bottom: 2px solid transparent;
		color: var(--text-body);
		font-weight: 600;
		transition: color 160ms ease, border-color 160ms ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--accent);
	}

	.nav-links a.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}

	main {
		width: min(100% - 40px, 960px);
		margin: 0 auto;
		flex: 1;
	}

	footer {
		padding: 17px 20px;
		border-top: 1px solid var(--border-subtle);
		color: var(--accent-muted);
		font-size: 0.85rem;
		text-align: center;
	}

	.footer-content {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 6px 8px;
	}

	.playwright-link {
		color: inherit;
		text-decoration-color: var(--border-subtle);
		text-underline-offset: 2px;
	}

	.playwright-link:hover {
		color: var(--accent);
	}

	.actions-badge {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		margin-left: 4px;
		line-height: 0;
	}

	.actions-badge img {
		display: block;
		width: auto;
		height: 20px;
		max-width: 100%;
	}
</style>
