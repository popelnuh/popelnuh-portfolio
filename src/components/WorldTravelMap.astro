<section id="world-travel-map" class="world-travel-map" aria-labelledby="world-map-heading">
	<div class="section-heading">
		<div>
			<p class="eyebrow">Travel</p>
			<h2 id="world-map-heading">Countries Visited</h2>
		</div>
		<p class="country-count" aria-label="38 countries visited">38 countries</p>
	</div>
	<p class="map-note">
		Explore the countries visited. Vatican City is shown as a pin because microstates are omitted
		from the Natural Earth 1:110m polygons.
	</p>
	<div class="world-map-shell" data-testid="world-map-shell">
		<div
			class="world-map"
			data-testid="world-travel-map"
			role="region"
			aria-label="World map showing countries visited"
		></div>
		<button
			class="world-map-reset"
			type="button"
			data-track="world-map-reset-view"
			data-testid="world-map-reset-view"
		>
			Reset view
		</button>
		<p class="world-map-status" role="status" aria-live="polite">Loading world map…</p>
	</div>
	<footer class="world-map-metadata">
		<span>Visited countries are highlighted in teal.</span>
		<span>
			Boundaries: <a
				href="https://www.naturalearthdata.com/downloads/110m-cultural-vectors/110m-admin-0-countries/"
				target="_blank"
				rel="noopener noreferrer"
			>Natural Earth 1:110m, public domain (CC0)</a>.
		</span>
	</footer>
</section>

<script>
	import * as L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import { resolveWorldFeatureIso3 } from '../lib/worldMapAdapter';

	interface VisitedCountry {
		iso3: string;
		name: string;
	}

	interface VisitedCountriesDataset {
		countries: VisitedCountry[];
	}

	interface WorldFeatureProperties extends Record<string, unknown> {
		ADMIN?: string;
		ISO_A3?: string;
	}

	const container = document.querySelector<HTMLElement>('[data-testid="world-travel-map"]');
	const shell = container?.closest<HTMLElement>('[data-testid="world-map-shell"]');
	const resetButton = shell?.querySelector<HTMLButtonElement>(
		'[data-testid="world-map-reset-view"]',
	);
	const status = shell?.querySelector<HTMLElement>('[role="status"]');

	if (container && resetButton && status) {
		const map = L.map(container, { minZoom: 1, maxZoom: 7 });
		const defaultCenter: L.LatLngExpression = [20, 10];
		const defaultZoom = 2;
		map.setView(defaultCenter, defaultZoom);

		resetButton.addEventListener('click', () => {
			map.setView(defaultCenter, defaultZoom, { animate: true });
		});

		const mapDataUrl = '/data/world-countries-110m.geojson';
		const visitedDataUrl = '/data/visited-countries.json';
		void Promise.all([
			fetch(mapDataUrl).then((response) => {
				if (!response.ok) throw new Error(`World boundaries request failed: ${response.status}`);
				return response.json();
			}),
			fetch(visitedDataUrl).then((response) => {
				if (!response.ok) throw new Error(`Visited-country data request failed: ${response.status}`);
				return response.json() as Promise<VisitedCountriesDataset>;
			}),
		])
			.then(([world, visitedDataset]) => {
				const visitedCodes = new Set(visitedDataset.countries.map(({ iso3 }) => iso3));
				let worldLayer: L.GeoJSON<WorldFeatureProperties>;
				worldLayer = L.geoJSON<WorldFeatureProperties>(world, {
					style: (feature) => {
						const iso3 = resolveWorldFeatureIso3(feature?.properties);
						return {
							color: '#ffffff',
							weight: 0.7,
							fillColor: iso3 && visitedCodes.has(iso3) ? '#0f766e' : '#e2e8f0',
							fillOpacity: 0.85,
						};
					},
					onEachFeature: (feature, layer) => {
						const properties = feature.properties;
						const name =
							typeof properties.ADMIN === 'string' ? properties.ADMIN : 'Unknown country';
						const iso3 = resolveWorldFeatureIso3(properties);
						const visited = iso3 !== null && visitedCodes.has(iso3);
						const tooltip = document.createElement('span');
						tooltip.textContent = `${name} · ${visited ? 'Visited' : 'Not yet visited'}`;
						layer.bindTooltip(tooltip, { sticky: true });
						if (layer instanceof L.Path) {
							layer.on({
								mouseover: () =>
									layer.setStyle({ color: '#0f172a', weight: 1.4, fillOpacity: 1 }),
								mouseout: () => worldLayer.resetStyle(layer),
							});
							if (iso3) {
								layer.on('add', () => {
									layer.getElement()?.setAttribute('data-testid', `world-region-${iso3}`);
								});
							}
						}
					},
				}).addTo(map);

				const bounds = worldLayer.getBounds();
				if (!bounds.isValid()) throw new Error('World boundaries contain no valid country polygons');
				map.fitBounds(bounds, { padding: [12, 12] });

				const vaticanMarker = L.circleMarker([41.9029, 12.4534], {
					radius: 6,
					color: '#ffffff',
					weight: 2,
					fillColor: '#0f766e',
					fillOpacity: 1,
				}).addTo(map);
				vaticanMarker.bindTooltip('Vatican City · Visited');
				vaticanMarker.getElement()?.setAttribute('data-testid', 'world-region-VAT');
				status.textContent = 'World map loaded. Hover over a country to see visit status.';
			})
			.catch((error: unknown) => {
				console.error(`Unable to load world travel map data from ${mapDataUrl}`, error);
				status.textContent = 'World map data could not be loaded.';
			});
	}
</script>

