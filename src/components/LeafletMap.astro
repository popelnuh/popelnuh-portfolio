---
import { mapStrategies, type MapStrategyKey } from '../lib/mapStrategies';

interface Props {
	boundariesUrl?: string;
	metricsUrl?: string;
	childcareMetricsUrl?: string;
	schoolUniformsUrl?: string;
	summerHolidaysUrl?: string;
	schoolStartingAgeUrl?: string;
	initialStrategy?: MapStrategyKey;
}

const {
	boundariesUrl = '/data/europe-countries.geojson',
	metricsUrl = '/data/renewable-energy.json',
	childcareMetricsUrl = '/data/oecd-childcare-costs.json',
	schoolUniformsUrl = '/data/europe-school-uniforms.json',
	summerHolidaysUrl = '/data/europe-summer-holidays.json',
	schoolStartingAgeUrl = '/data/europe-school-starting-age.json',
	initialStrategy = 'renewable',
} = Astro.props;
---

<div class="map-shell" data-testid="map-shell">
	<div
		class="leaflet-map"
		data-testid="leaflet-map"
		data-boundaries-url={boundariesUrl}
		data-metrics-url={metricsUrl}
		data-childcare-metrics-url={childcareMetricsUrl}
		data-school-uniforms-url={schoolUniformsUrl}
		data-summer-holidays-url={summerHolidaysUrl}
		data-school-starting-age-url={schoolStartingAgeUrl}
		data-initial-strategy={initialStrategy}
		role="region"
		aria-label={mapStrategies[initialStrategy].ariaLabel}
	></div>
	<p class="map-status" role="status" aria-live="polite">Loading map data…</p>
</div>

<script>
	import * as L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import {
		fetchMapJson,
		loadChildcareMapData,
		loadSchoolUniformMapData,
		loadSummerHolidayMapData,
		loadSchoolStartingAgeMapData,
	} from '../lib/mapRepository';
	import { mapStrategies, type MapStrategyKey } from '../lib/mapStrategies';
	import { isSafeHttpsUrl } from '../lib/adapters/schoolUniformsAdapter';
	import {
		joinRenewableEnergyData,
		type RenewableEnergyDataset,
	} from '../lib/renewableEnergyAdapter';
	import type {
		CountryBoundaries,
		MapMetricBoundaries,
		MapMetricProperties,
	} from '../lib/mapTypes';

	for (const container of document.querySelectorAll<HTMLElement>('[data-testid="leaflet-map"]')) {
		const status = container.parentElement?.querySelector<HTMLElement>('.map-status');
		const boundariesUrl = container.dataset.boundariesUrl ?? '/data/europe-countries.geojson';
		const metricsUrl = container.dataset.metricsUrl ?? '/data/renewable-energy.json';
		const childcareMetricsUrl =
			container.dataset.childcareMetricsUrl ?? '/data/oecd-childcare-costs.json';
		const schoolUniformsUrl =
			container.dataset.schoolUniformsUrl ?? '/data/europe-school-uniforms.json';
		const summerHolidaysUrl =
			container.dataset.summerHolidaysUrl ?? '/data/europe-summer-holidays.json';
		const schoolStartingAgeUrl =
			container.dataset.schoolStartingAgeUrl ?? '/data/europe-school-starting-age.json';
		const configuredStrategy = container.dataset.initialStrategy;
		const initialStrategyKey: MapStrategyKey =
			configuredStrategy === 'renewable' ||
			configuredStrategy === 'childcare' ||
			configuredStrategy === 'school-uniforms' ||
			configuredStrategy === 'free-school-meals' ||
			configuredStrategy === 'summer-holidays' ||
			configuredStrategy === 'school-starting-age' ||
			configuredStrategy === 'teacher-qualifications' ||
			configuredStrategy === 'religious-education'
				? configuredStrategy
				: 'renewable';
		const map = L.map(container);
		let countriesLayer: L.GeoJSON | null = null;
		let loadSequence = 0;
		let defaultView: { center: L.LatLng; zoom: number } | null = null;

		const DEFAULT_EUROPE_CENTER: L.LatLngExpression = [54, 15];
		const DEFAULT_EUROPE_ZOOM = 4;

		class ResetViewControl extends L.Control {
			onAdd(controlMap: L.Map): HTMLElement {
				const control = L.DomUtil.create(
					'div',
					'leaflet-bar leaflet-reset-view-control',
				);
				const button = L.DomUtil.create(
					'button',
					'reset-view-button',
					control,
				) as HTMLButtonElement;

				button.type = 'button';
				button.textContent = 'Reset view';
				button.title = 'Reset map view to Europe';
				button.setAttribute('aria-label', 'Reset view');
				button.dataset.track = 'map-reset-view';
				button.dataset.testid = 'map-reset-view';
				button.addEventListener('click', () => {
					controlMap.setView(
						defaultView?.center ?? DEFAULT_EUROPE_CENTER,
						defaultView?.zoom ?? DEFAULT_EUROPE_ZOOM,
						{ animate: true },
					);
				});
				L.DomEvent.disableClickPropagation(control);
				L.DomEvent.disableScrollPropagation(control);

				return control;
			}
		}

		new ResetViewControl({ position: 'topleft' }).addTo(map);

		map.attributionControl.setPrefix(false);
		map.attributionControl.addAttribution(
			'&copy; EuroGeographics for the administrative boundaries',
		);

		const updateMap = async (strategyKey: MapStrategyKey): Promise<void> => {
			const sequence = ++loadSequence;
			const strategy = mapStrategies[strategyKey];
			if (status) status.textContent = `Loading ${strategy.title.toLowerCase()} map…`;

			try {
				let boundaries: MapMetricBoundaries;
				let referenceYear: number | undefined;
				let indicator = strategy.title;

				if (strategyKey === 'renewable') {
					const [rawBoundaries, metrics] = await Promise.all([
						fetchMapJson<CountryBoundaries>(boundariesUrl),
						fetchMapJson<RenewableEnergyDataset>(metricsUrl),
					]);
					boundaries = joinRenewableEnergyData(rawBoundaries, metrics);
					referenceYear = metrics.referenceYear;
					indicator = metrics.indicator;
				} else if (strategyKey === 'childcare') {
					const { boundaries: rawBoundaries, dataset, recordsByCNTR_ID } =
						await loadChildcareMapData(boundariesUrl, childcareMetricsUrl);
					boundaries = {
						...rawBoundaries,
						features: rawBoundaries.features.map((feature) => {
							const record = recordsByCNTR_ID[feature.properties.CNTR_ID];
							return {
								...feature,
								properties: {
									...feature.properties,
									metricValue: record?.value ?? null,
									estimated: false,
								},
							};
						}),
					};
					referenceYear = dataset.referenceYear;
					indicator = dataset.indicator;
				} else if (
					strategyKey === 'school-uniforms' ||
					strategyKey === 'free-school-meals' ||
					strategyKey === 'teacher-qualifications' ||
					strategyKey === 'religious-education'
				) {
					const { boundaries: rawBoundaries, recordsByGiscoId } =
						await loadSchoolUniformMapData(boundariesUrl, schoolUniformsUrl);
					boundaries = {
						...rawBoundaries,
						features: rawBoundaries.features.map((feature) => {
							const record = recordsByGiscoId[feature.properties.CNTR_ID];
							return {
								...feature,
								properties: {
									...feature.properties,
									metricValue: record?.category ?? null,
									estimated: false,
									policyNote: record?.note,
									sourceLabel: record?.sourceLabel,
									sourceUrl: record?.sourceUrl,
								},
							};
						}),
					};
				} else if (strategyKey === 'summer-holidays') {
					const { boundaries: rawBoundaries, recordsByGiscoId } =
						await loadSummerHolidayMapData(boundariesUrl, summerHolidaysUrl);
					boundaries = {
						...rawBoundaries,
						features: rawBoundaries.features.map((feature) => {
							const record = recordsByGiscoId[feature.properties.CNTR_ID];
							return {
								...feature,
								properties: {
									...feature.properties,
									metricValue: record?.weeks ?? null,
									estimated: false,
									policyNote: record?.note,
									sourceLabel: record?.sourceLabel,
									sourceUrl: record?.sourceUrl,
								},
							};
						}),
					};
					indicator = 'Summer school holiday duration';
				} else {
					const { boundaries: rawBoundaries, recordsByGiscoId } =
						await loadSchoolStartingAgeMapData(boundariesUrl, schoolStartingAgeUrl);
					boundaries = {
						...rawBoundaries,
						features: rawBoundaries.features.map((feature) => {
							const record = recordsByGiscoId[feature.properties.CNTR_ID];
							return {
								...feature,
								properties: {
									...feature.properties,
									metricValue: record?.age ?? null,
									estimated: false,
									policyNote: record?.note,
									sourceLabel: record?.sourceLabel,
									sourceUrl: record?.sourceUrl,
								},
							};
						}),
					};
					indicator = 'Compulsory education starting age';
				}

				if (sequence !== loadSequence) return;

				countriesLayer?.remove();
				const countries = L.geoJSON<MapMetricProperties>(boundaries, {
					style: (feature) => ({
						color: '#ffffff',
						weight: 1.5,
						fillColor: strategy.colorScale(feature?.properties?.metricValue ?? null),
						fillOpacity: 0.8,
					}),
					onEachFeature: (feature, layer) => {
						const properties = feature.properties;
						const countryName =
							properties?.NAME_ENGL ?? properties?.CNTR_NAME ?? properties?.CNTR_ID ?? 'Unknown country';
						const countryId = properties?.CNTR_ID ?? 'unknown';
						const value = properties?.metricValue ?? null;
						const tooltipContext = {
							country: countryName,
							value,
							year: referenceYear,
							estimated: properties?.estimated ?? false,
							indicator,
							unit: strategy.unitLabel,
							note: properties?.policyNote,
							sourceLabel: properties?.sourceLabel,
							sourceUrl: properties?.sourceUrl,
						};
						const metricText = strategy.formatTooltip(tooltipContext);
						const popupDetails = strategy.formatPopup?.(tooltipContext);
						const createTooltipContent = (): HTMLDivElement => {
							const content = document.createElement('div');
							const name = document.createElement('strong');
							const metric = document.createElement('p');
							name.textContent = countryName;
							metric.textContent = metricText;
							content.append(name, metric);
							return content;
						};
						const createPopupContent = (): HTMLDivElement => {
							const content = document.createElement('div');
							const name = document.createElement('strong');
							const metric = document.createElement('p');
							name.textContent = countryName;
							metric.textContent = popupDetails?.valueLabel ?? metricText;
							content.append(name, metric);

							if (popupDetails?.note) {
								const note = document.createElement('p');
								note.textContent = popupDetails.note;
								content.append(note);
							}

							if (
								popupDetails?.sourceLabel &&
								isSafeHttpsUrl(popupDetails.sourceUrl)
							) {
								const source = document.createElement('p');
								const link = document.createElement('a');
								link.href = popupDetails.sourceUrl;
								link.target = '_blank';
								link.rel = 'noopener noreferrer';
								link.textContent = popupDetails.sourceLabel;
								source.append('Source: ', link);
								content.append(source);
							}

							return content;
						};

						layer.bindPopup(createPopupContent());
						layer.on('popupopen', (event: L.PopupEvent) => {
							event.popup.getElement()?.setAttribute('data-testid', 'map-country-popup');
						});
						layer.bindTooltip(createTooltipContent(), { sticky: true });

						if (layer instanceof L.Path) {
							layer.on('add', () => {
								layer.getElement()?.setAttribute('data-testid', `map-region-${countryId}`);
							});
							layer.on({
								mouseover: () => {
									layer.setStyle({ color: '#171a24', weight: 2.5, fillOpacity: 0.95 });
									layer.bringToFront();
								},
								mouseout: () => countries.resetStyle(layer),
							});
						}
					},
				}).addTo(map);
				countriesLayer = countries;
				container.setAttribute('aria-label', strategy.ariaLabel);

				const bounds = countries.getBounds();
				if (!bounds.isValid()) {
					throw new Error('Map data does not contain any valid country polygons');
				}

				map.fitBounds(bounds, { padding: [16, 16] });
				if (!defaultView) {
					defaultView = { center: map.getCenter(), zoom: map.getZoom() };
				}
				if (status) status.textContent = 'Map data loaded. Select a country for details.';
			} catch (error: unknown) {
				if (sequence !== loadSequence) return;
				console.error(
					`Unable to load ${strategy.title.toLowerCase()} map data from ${boundariesUrl}`,
					error,
				);
				if (status) status.textContent = 'Map data could not be loaded.';
			}
		};

		container.addEventListener('map:strategy-change', (event) => {
			if (!(event instanceof CustomEvent)) return;
			if (
				event.detail !== 'renewable' &&
				event.detail !== 'childcare' &&
				event.detail !== 'school-uniforms' &&
				event.detail !== 'summer-holidays' &&
				event.detail !== 'school-starting-age' &&
				event.detail !== 'teacher-qualifications' &&
				event.detail !== 'religious-education'
			) {
				return;
			}
			void updateMap(event.detail);
		});

		void updateMap(initialStrategyKey);
	}
</script>

<style>
	.map-shell {
		width: 100%;
		min-height: 500px;
	}

	.leaflet-map {
		width: 100%;
		height: 500px;
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		background: #eef2f4;
	}

	.map-status {
		margin: 10px 0 0;
		color: var(--text-body);
		font-size: 0.9rem;
	}

	:global(.leaflet-reset-view-control) {
		overflow: hidden;
		border: 1px solid var(--border-subtle);
		border-radius: 4px;
		background: #fff;
		box-shadow: 0 1px 5px rgb(15 23 42 / 25%);
		transition: border-color 160ms ease;
	}

	:global(.leaflet-reset-view-control:hover) {
		border-color: var(--accent);
	}

	:global(.leaflet-reset-view-control .reset-view-button) {
		display: block;
		width: auto;
		min-width: 88px;
		height: 32px;
		border: 0;
		padding: 0 10px;
		background: #fff;
		color: var(--text-body);
		font: 600 0.75rem/32px system-ui, sans-serif;
		text-align: center;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	:global(.leaflet-reset-view-control .reset-view-button:hover) {
		background: var(--accent-soft);
		color: var(--accent);
	}

	:global(.leaflet-reset-view-control .reset-view-button:focus-visible) {
		position: relative;
		z-index: 1;
		outline: 2px solid var(--accent);
		outline-offset: -3px;
	}

	@media (max-width: 767px) {
		.map-shell {
			min-height: max(360px, 58vh);
		}

		.leaflet-map {
			height: 58vh;
			min-height: 360px;
		}
	}
</style>
