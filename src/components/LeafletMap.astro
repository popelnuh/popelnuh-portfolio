---
interface Props {
	boundariesUrl?: string;
	metricsUrl?: string;
}

const {
	boundariesUrl = '/data/europe-countries.geojson',
	metricsUrl = '/data/renewable-energy.json',
} = Astro.props;
---

<div class="map-shell">
	<div
		class="leaflet-map"
		data-testid="leaflet-map"
		data-boundaries-url={boundariesUrl}
		data-metrics-url={metricsUrl}
		role="region"
		aria-label="European countries by renewable energy share"
	></div>
	<p class="map-status" role="status" aria-live="polite">Loading map data…</p>
</div>

<script>
	import * as L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import {
		joinRenewableEnergyData,
		NO_DATA_COLOR,
		type CountryBoundaries,
		type RenewableEnergyDataset,
	} from '../lib/renewableEnergyAdapter';

	for (const container of document.querySelectorAll<HTMLElement>('[data-testid="leaflet-map"]')) {
		const status = container.parentElement?.querySelector<HTMLElement>('.map-status');
		const boundariesUrl = container.dataset.boundariesUrl ?? '/data/europe-countries.geojson';
		const metricsUrl = container.dataset.metricsUrl ?? '/data/renewable-energy.json';
		const map = L.map(container);

		map.attributionControl.setPrefix(false);
		map.attributionControl.addAttribution(
			'&copy; EuroGeographics for the administrative boundaries',
		);

		void Promise.all([fetch(boundariesUrl), fetch(metricsUrl)])
			.then(async ([boundariesResponse, metricsResponse]) => {
				if (!boundariesResponse.ok) {
					throw new Error(`Boundary request failed with status ${boundariesResponse.status}`);
				}
				if (!metricsResponse.ok) {
					throw new Error(`Metric request failed with status ${metricsResponse.status}`);
				}
				const [boundaries, metrics] = await Promise.all([
					boundariesResponse.json() as Promise<CountryBoundaries>,
					metricsResponse.json() as Promise<RenewableEnergyDataset>,
				]);
				return { boundaries: joinRenewableEnergyData(boundaries, metrics), metrics };
			})
			.then(({ boundaries, metrics }) => {
				const countries = L.geoJSON(boundaries, {
					style: (feature) => ({
						color: '#ffffff',
						weight: 1.5,
						fillColor: feature?.properties?.choropleth_color ?? NO_DATA_COLOR,
						fillOpacity: 0.8,
					}),
					onEachFeature: (feature, layer) => {
						const properties = feature.properties;
						const countryName =
							properties?.NAME_ENGL ?? properties?.CNTR_NAME ?? properties?.CNTR_ID ?? 'Unknown country';
						const countryId = properties?.CNTR_ID ?? 'unknown';
						const value = properties?.renewable_energy_pct ?? null;
						const popup = document.createElement('div');
						const name = document.createElement('strong');
						const metric = document.createElement('p');

						name.textContent = countryName;
						metric.textContent =
							value === null
								? `${metrics.indicator}: no data`
								: `${metrics.indicator} (${metrics.referenceYear}): ${value.toFixed(1)}${metrics.unit}${properties?.estimated ? ' (estimate)' : ''}`;
						popup.append(name, metric);
						layer.bindPopup(popup);

						if (layer instanceof L.Path) {
							layer.on('add', () => {
								layer.getElement()?.setAttribute('data-testid', `map-region-${countryId}`);
							});
							layer.on({
								mouseover: () => {
									layer.setStyle({ color: '#171a24', weight: 2.5, fillOpacity: 0.95 });
									layer.bringToFront();
								},
								mouseout: () => countries.resetStyle(layer),
							});
						}
					},
				}).addTo(map);

				const bounds = countries.getBounds();
				if (!bounds.isValid()) {
					throw new Error('Map data does not contain any valid country polygons');
				}

				map.fitBounds(bounds, { padding: [16, 16] });
				if (status) status.textContent = 'Map data loaded. Select a country for details.';
			})
			.catch((error: unknown) => {
				console.error(`Unable to load map data from ${boundariesUrl} and ${metricsUrl}`, error);
				if (status) status.textContent = 'Map data could not be loaded.';
			});
	}
</script>

<style>
	.map-shell {
		width: 100%;
	}

	.leaflet-map {
		width: 100%;
		height: 500px;
		border: 1px solid #dfe2ea;
		border-radius: 12px;
		background: #eef2f4;
	}

	.map-status {
		margin: 10px 0 0;
		color: #555b6b;
		font-size: 0.9rem;
	}
</style>
