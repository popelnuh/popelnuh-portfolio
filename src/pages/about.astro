---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Zlata Popelnuh">
	<section class="about">
		<p class="eyebrow">ABOUT ME</p>
		<h1>Zlata Popelnuh</h1>

		<div class="about-grid" data-testid="about-grid">
			<div class="bio-column">
				<article class="bio-card" data-testid="about-bio-card">
          <p>
            I’m a Senior Test Automation Engineer with 10+ years of experience
            driving functional, integration, and performance quality across
            cloud platforms, distributed microservices, and regulated enterprise
            systems. Working primarily with Playwright, .NET (C#), Python, and
            Azure DevOps, I design scalable test frameworks and CI/CD pipelines
            that surface architectural bottlenecks before production—alongside
            building deterministic guardrails for AI-assisted workflows.
          </p>
          <p>
            With an MSc in Geographical Information Systems and an earlier
            career in GIS consultancy, I still look at complex problems through
            a spatial lens. This site brings both worlds together: interactive
            European data maps backed by clean architecture patterns and
            automated tests.
          </p>
          <p>Based in Scotland, UK.</p>
        </article>

				<div class="links" aria-label="Contact and professional profiles">
					<a
						href="https://linkedin.com/in/zlata-popelnuh"
						target="_blank"
						rel="noopener noreferrer"
						data-track="outbound-linkedin"
						data-testid="outbound-linkedin"
					>
						<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
							<path
								fill="currentColor"
								d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"
							/>
						</svg>
						LinkedIn
					</a>
					<a
						href="https://github.com/popelnuh"
						target="_blank"
						rel="noopener noreferrer"
						data-track="outbound-github"
						data-testid="outbound-github"
					>
						<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
							<path
								fill="currentColor"
								d="M12 .3a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.23c-3.34.72-4.04-1.42-4.04-1.42-.55-1.38-1.34-1.75-1.34-1.75-1.09-.75.09-.73.09-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.84 2.81 1.31 3.49 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A12 12 0 0 0 12 .3Z"
							/>
						</svg>
						GitHub
					</a>
					<a
						href="mailto:popelnuh@gmail.com"
						data-email-link
						data-track="outbound-email"
						data-testid="outbound-email"
					>
						<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20">
							<path
								d="M3 5.5h14v9H3zM3.5 6l6.5 5 6.5-5"
								fill="none"
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
							/>
						</svg>
						popelnuh@gmail.com
					</a>
				</div>
				<p class="email-status" id="email-status" role="status" aria-live="polite"></p>
			</div>

			<aside class="glance-card" aria-labelledby="glance-heading">
				<h2 id="glance-heading">At a Glance</h2>
				<dl class="metadata">
					<div>
						<dt>Location</dt>
						<dd class="coordinates">55.86° N, 4.25° W · Scotland, UK</dd>
					</div>
					<div>
						<dt>Certification</dt>
						<dd>ISTQB · CSM · Azure (AZ-900)</dd>
					</div>
					<div>
						<dt>Experience</dt>
						<dd>10+ years in QA &amp; Automation</dd>
					</div>
				</dl>

				<section class="stack" aria-labelledby="stack-heading">
					<h3 id="stack-heading">Core Stack</h3>
					<ul class="badges" aria-label="Core technologies">
						<li>Playwright</li>
						<li>.NET (C#)</li>
						<li>TypeScript</li>
						<li>Python</li>
						<li>JMeter</li>
						<li>SpecFlow / BDD</li>
						<li>RestSharp</li>
						<li>Azure DevOps</li>
						<li>AWS</li>
						<li>Docker</li>
						<li>SQL</li>
						<li>GIS / Leaflet</li>
					</ul>
				</section>
			</aside>
		</div>
	</section>
</Layout>

<script>
	const emailLink = document.querySelector<HTMLAnchorElement>('[data-email-link]');
	const emailStatus = document.querySelector<HTMLElement>('#email-status');

	emailLink?.addEventListener('click', () => {
		if (!emailStatus) return;

		const emailAddress = 'popelnuh@gmail.com';
		emailStatus.textContent = `If your mail app did not open, copy ${emailAddress}.`;
		if (!navigator.clipboard) return;

		void navigator.clipboard.writeText(emailAddress).then(
			() => {
				emailStatus.textContent = `Email address copied to clipboard: ${emailAddress}.`;
			},
			() => {
				emailStatus.textContent = `Copy unavailable. Email: ${emailAddress}.`;
			},
		);
	});
</script>

<style>
	.about {
		padding: 72px 0 80px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent-muted);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
	}

	h1 {
		margin: 0 0 32px;
		color: var(--text-primary);
		font-size: clamp(3rem, 8vw, 5.5rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		align-items: start;
		gap: 24px;
	}

	.bio-card,
	.glance-card {
		border: 1px solid var(--border-subtle);
		background: white;
		box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05);
	}

	.bio-card {
		padding: 28px 30px;
		border-left: 3px solid var(--accent);
		border-radius: 0 12px 12px 0;
	}

	.bio-card p {
		margin: 0;
		color: var(--text-body);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.75;
	}

	.bio-card p + p {
		margin-top: 14px;
	}

	.glance-card {
		padding: 26px;
		border-radius: 12px;
	}

	.glance-card h2,
	.stack h3 {
		margin: 0;
		color: var(--text-primary);
	}

	.glance-card h2 {
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}

	.metadata {
		display: grid;
		gap: 16px;
		margin: 22px 0 0;
	}

	.metadata dt {
		margin-bottom: 4px;
		color: var(--accent-muted);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.metadata dd {
		margin: 0;
		color: var(--text-body);
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.5;
	}

	.metadata .coordinates {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.84rem;
	}

	.stack {
		margin-top: 24px;
		padding-top: 20px;
		border-top: 1px solid var(--border-subtle);
	}

	.stack h3 {
		margin-bottom: 14px;
		font-size: 0.98rem;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.badges li {
		padding: 6px 9px;
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		background: var(--accent-soft);
		color: var(--text-body);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.74rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 20px;
	}

	.links a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 9px;
		padding: 10px 15px;
		border: 1px solid var(--border-subtle);
		border-radius: 9px;
		background: white;
		color: var(--text-primary);
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			box-shadow 160ms ease;
	}

	.links svg {
		width: 17px;
		height: 17px;
	}

	.links a:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: 0 6px 16px rgba(15, 23, 42, 0.1);
	}

	.links a:focus-visible {
		outline: 3px solid rgba(30, 41, 59, 0.28);
		outline-offset: 3px;
	}

	.email-status {
		min-height: 1.4em;
		margin: 8px 0 0;
		color: var(--accent-muted);
		font-size: 0.85rem;
	}

	@media (max-width: 760px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.about {
			padding: 56px 0 64px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.links a {
			transition: none;
		}

		.links a:hover {
			transform: none;
		}
	}
</style>
