---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Zlata Popelnuh">
	<section class="about">
		<p class="eyebrow">About me</p>
		<h1>Zlata Popelnuh</h1>

		<div class="content">
			<p>
				I am an ISTQB-certified quality and test automation professional with over 8 years of
				experience in testing.
			</p>
			<p>
				I work with Playwright, C#, Python, and Azure DevOps, and I have also explored GIS,
				QGIS, mapping, and spatial data. Previously a GIS specialist, I now focus on
				quality, test automation, and exploring new frameworks.
			</p>
			<p>Based in Scotland, UK.</p>
		</div>

		<div class="links" aria-label="Professional profiles">
			<a href="https://linkedin.com/in/zlata-popelnuh" target="_blank" rel="noopener noreferrer">
				LinkedIn
			</a>
			<a href="https://github.com/popelnuh" target="_blank" rel="noopener noreferrer">
				GitHub
			</a>
		</div>
	</section>
</Layout>

<style>
	.about {
		max-width: 760px;
		padding: 96px 0;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #635bff;
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 36px;
		font-size: clamp(3rem, 8vw, 5.5rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.content {
		max-width: 680px;
		padding: 28px 32px;
		border-left: 3px solid #635bff;
		background: white;
		box-shadow: 0 16px 40px rgba(32, 35, 48, 0.06);
	}

	.content p {
		margin: 0;
		color: #555b6b;
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.content p + p {
		margin-top: 16px;
	}

	.links {
		display: flex;
		gap: 12px;
		margin-top: 28px;
	}

	.links a {
		padding: 11px 16px;
		border: 1px solid #dfe2ea;
		border-radius: 8px;
		background: white;
		color: #171a24;
		font-weight: 700;
		text-decoration: none;
	}

	.links a:hover {
		border-color: #635bff;
		color: #635bff;
	}
</style>
