---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Zlata Popelnuh">
	<section class="hero">
		<p class="eyebrow">Quality, testing, and automation</p>
		<h1>Welcome</h1>
		<p class="intro">I’m Zlata Popelnuh, a quality and test automation lead based in Scotland.</p>
		<a class="button" href="/about">Learn more about me</a>
	</section>
</Layout>

<style>
	.hero {
		min-height: calc(100vh - 72px);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: 64px 0;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #635bff;
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 10vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.intro {
		max-width: 620px;
		margin: 28px 0 32px;
		color: #555b6b;
		font-size: clamp(1.1rem, 3vw, 1.35rem);
		line-height: 1.6;
	}

	.button {
		padding: 13px 18px;
		border-radius: 10px;
		background: #635bff;
		color: white;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 10px 24px rgba(99, 91, 255, 0.18);
	}

	.button:hover {
		background: #5048e5;
	}
</style>
