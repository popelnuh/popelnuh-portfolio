---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Zlata Popelnuh">
	<section class="hero">
		<p class="eyebrow">QUALITY ENGINEERING · GEOSPATIAL DATA</p>
		<h1>
			Testing complex systems.<br />{' '}
			Mapping data.
		</h1>
		<p class="intro">
			I’m Zlata Popelnuh, a Scotland-based SDTE with a background in
			GIS. I build resilient test frameworks, validate system reliability and performance, and
			turn public datasets into interactive maps.
		</p>
		<div class="actions">
			<a
				class="button button-primary"
				href="/maps"
				data-track="cta-explore-maps"
				data-testid="hero-explore-maps"
			>
				Explore Maps
				<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20">
					<path
						d="M4.167 10h11.666m-5-5 5 5-5 5"
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.7"
					/>
				</svg>
			</a>
			<a
				class="button button-secondary"
				href="/about"
				data-track="cta-about-me"
				data-testid="hero-about-me"
			>Learn more about me</a>
		</div>
	</section>

	<section class="highlights" aria-labelledby="focus-heading">
		<h2 id="focus-heading">Focus Areas</h2>
		<div class="highlight-grid">
			<article>
				<a class="highlight-card" href="/quality" data-testid="focus-quality-link">
					<p class="card-tag">01 / QUALITY</p>
					<h3>Test Automation &amp; Reliability</h3>
					<p>
						Designing scalable Playwright and .NET/C# frameworks, CI/CD quality pipelines, and
						end-to-end performance checks for reliable software delivery.
					</p>
				</a>
			</article>

			<article>
				<a class="highlight-card" href="/quality" data-testid="focus-architecture-link">
					<p class="card-tag">02 / ARCHITECTURE</p>
					<h3>Clean Patterns &amp; AI Validation</h3>
					<p>
						Applying Adapter, Strategy, and Page Object Model patterns alongside deterministic
						guardrails and unit-tested contracts for AI-assisted workflows.
					</p>
				</a>
			</article>

			<article>
				<a class="highlight-card" href="/maps" data-testid="focus-geospatial-link">
					<p class="card-tag">03 / GEOSPATIAL</p>
					<h3>Interactive European Maps</h3>
					<p>
						Visualizing comparative European energy, childcare, and education policy datasets with
						Leaflet, Eurostat GISCO boundaries, and OECD data.
					</p>
				</a>
			</article>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding: 72px 0 56px;
	}

	.eyebrow,
	.card-tag {
		color: var(--accent-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.eyebrow {
		margin: 0 0 18px;
	}

	h1 {
		max-width: 860px;
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(2.5rem, 6vw, 4.25rem);
		line-height: 1.08;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.intro {
		max-width: 760px;
		margin: 22px 0 28px;
		color: var(--text-body);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		font-weight: 400;
		line-height: 1.7;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button {
		display: inline-flex;
		min-height: 46px;
		align-items: center;
		justify-content: center;
		gap: 9px;
		padding: 11px 17px;
		border: 1px solid transparent;
		border-radius: 9px;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.button svg {
		width: 18px;
		height: 18px;
	}

	.button-primary {
		background: var(--accent);
		color: white;
		box-shadow: 0 8px 20px rgba(15, 23, 42, 0.14);
	}

	.button-primary:hover {
		transform: translateY(-1px);
		background: var(--accent-hover);
	}

	.button-secondary {
		border-color: var(--border-subtle);
		background: white;
		color: var(--text-primary);
	}

	.button-secondary:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
	}

	.button:focus-visible {
		outline: 3px solid rgba(30, 41, 59, 0.28);
		outline-offset: 3px;
	}

	.highlights {
		padding: 28px 0 72px;
		border-top: 1px solid var(--border-subtle);
	}

	.highlights h2 {
		margin: 0 0 18px;
		color: var(--text-primary);
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}

	.highlight-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.highlight-card {
		display: block;
		height: 100%;
		padding: 21px 22px 23px;
		border: 1px solid var(--border-subtle);
		border-top: 3px solid var(--accent);
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
		color: inherit;
		text-decoration: none;
		transition:
			transform 160ms ease,
			box-shadow 160ms ease;
	}

	.highlight-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 28px rgba(15, 23, 42, 0.09);
	}

	.highlight-card:focus-visible {
		outline: 3px solid rgba(30, 41, 59, 0.28);
		outline-offset: 3px;
	}

	.card-tag {
		margin: 0 0 13px;
		font-size: 0.7rem;
	}

	.highlight-card h3 {
		margin: 0 0 10px;
		color: var(--text-primary);
		font-size: 1.08rem;
		line-height: 1.35;
	}

	.highlight-card > p:last-child {
		margin: 0;
		color: var(--text-body);
		font-size: 0.94rem;
		font-weight: 400;
		line-height: 1.65;
	}

	@media (max-width: 760px) {
		.hero {
			padding: 56px 0 42px;
		}

		.highlight-grid {
			grid-template-columns: 1fr;
		}

		.highlights {
			padding-bottom: 56px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}

		.button:hover {
			transform: none;
		}

		.highlight-card {
			transition: none;
		}

		.highlight-card:hover {
			transform: none;
		}
	}
</style>
