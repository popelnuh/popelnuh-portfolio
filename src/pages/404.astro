---
import { Image } from 'astro:assets';
import oxImage from '../assets/404-ox.jpg';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found | Zlata Popelnuh"
	description="The page you're looking for could not be found. Head back home to explore the portfolio."
>
	<section class="not-found" aria-labelledby="not-found-heading">
		<div class="not-found-content">
			<p class="eyebrow">404 ERROR</p>
			<h1 id="not-found-heading">Lost in the Highlands?</h1>
			<figure class="photo-frame">
				<Image
					src={oxImage}
					width={800}
					height={533}
					alt="A brown Highland cow on a misty mountain with a 404 Page Not Found label across the middle"
					loading="eager"
				/>
				<span class="photo-label" aria-hidden="true">404 · PAGE NOT FOUND</span>
			</figure>
			<p class="message">
				It looks like the page you are searching for doesn't exist, or has been moved.
			</p>
			<a class="home-button" href="/">Take me back home</a>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		padding: 72px 24px 88px;
	}

	.not-found-content {
		width: min(100%, 720px);
		margin: 0 auto;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--accent-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(2.4rem, 7vw, 4rem);
		letter-spacing: -0.05em;
		line-height: 1.05;
		text-wrap: balance;
	}

	.photo-frame {
		position: relative;
		overflow: hidden;
		margin: 32px 0 24px;
		border: 1px solid var(--border-subtle);
		border-radius: 18px;
		background: var(--accent-soft);
		box-shadow: 0 18px 42px rgba(15, 23, 42, 0.14);
	}

	.photo-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.photo-label {
		position: absolute;
		top: 7%;
		left: 5%;
		padding: 9px 16px;
		border: 1px solid rgba(255, 255, 255, 0.45);
		border-radius: 8px;
		background: rgba(15, 23, 42, 0.82);
		color: white;
		font-size: clamp(0.82rem, 2.8vw, 1.05rem);
		font-weight: 750;
		letter-spacing: 0.12em;
		white-space: nowrap;
	}

	.message {
		max-width: 560px;
		margin: 0 auto 24px;
		color: var(--text-body);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.home-button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		padding: 12px 20px;
		border: 1px solid var(--accent);
		border-radius: 8px;
		background: var(--accent);
		color: white;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	.home-button:hover {
		transform: translateY(-2px);
		background: var(--accent-hover);
	}

	.home-button:focus-visible {
		outline: 3px solid rgba(30, 41, 59, 0.3);
		outline-offset: 3px;
	}

	@media (max-width: 600px) {
		.not-found {
			padding: 56px 18px 64px;
		}

		.photo-frame {
			margin-top: 26px;
			border-radius: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-button {
			transition: none;
		}

		.home-button:hover {
			transform: none;
		}
	}
</style>
