---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { estimateReadingTime, formatPostDate, getPublishedPosts } from '../../lib/blog';

const posts = getPublishedPosts(await getCollection('blog'));
---

<Layout
	title="Blog | Zlata Popelnuh"
	description="Personal essays on education, place, and the details that shape everyday life."
>
	<section class="blog-index" aria-labelledby="blog-heading">
		<p class="eyebrow">NOTES &amp; OBSERVATIONS</p>
		<h1 id="blog-heading" data-testid="blog-heading">Blog</h1>
		<p class="introduction">
			Personal essays on education, place, and the small details that shape everyday life.
		</p>

		{
			posts.length > 0 ? (
				<ul
					class="post-list"
					aria-label="Published essays"
					data-testid="blog-published-essays"
				>
					{posts.map((post) => (
						<li>
							<article class="post-card" data-testid={`blog-post-entry-${post.id}`}>
								<a
									href={`/blog/${post.id}`}
									data-track="blog-post-open"
									data-testid="blog-post-card"
								>
									<div class="post-meta">
										<time datetime={post.data.pubDate.toISOString()}>
											{formatPostDate(post.data.pubDate)}
										</time>
										<span aria-hidden="true">·</span>
										<span>{estimateReadingTime(post.body ?? '')} min read</span>
									</div>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</a>
							</article>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">Essays are on their way.</p>
			)
		}
	</section>
</Layout>

<style>
	.blog-index {
		padding: 72px 0 80px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.introduction {
		max-width: 62ch;
		margin: 20px 0 36px;
		color: var(--text-body);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.post-list {
		display: grid;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-card {
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 12px 32px rgb(15 23 42 / 5%);
	}

	.post-card a {
		display: block;
		padding: 24px 26px;
		color: inherit;
		text-decoration: none;
	}

	.post-card a:hover h2 {
		color: var(--accent-muted);
	}

	.post-card a:focus-visible {
		border-radius: 12px;
		outline: 3px solid rgb(30 41 59 / 28%);
		outline-offset: 3px;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		color: var(--accent-muted);
		font-size: 0.86rem;
	}

	h2 {
		margin: 12px 0 8px;
		color: var(--text-primary);
		font-size: clamp(1.35rem, 3vw, 1.65rem);
		letter-spacing: -0.03em;
		transition: color 160ms ease;
	}

	.post-card p,
	.empty-state {
		margin: 0;
		color: var(--text-body);
		line-height: 1.65;
	}

	@media (max-width: 700px) {
		.blog-index {
			padding: 56px 0 64px;
		}

		.post-card a {
			padding: 20px;
		}
	}
</style>
