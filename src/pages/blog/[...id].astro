---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeyerdahlMap from '../../components/HeyerdahlMap.astro';
import { estimateReadingTime, formatPostDate, getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = getPublishedPosts(await getCollection('blog'));
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = estimateReadingTime(post.body ?? '');
---

<Layout title={`${post.data.title} | Zlata Popelnuh`} description={post.data.description}>
	<section class="essay-page">
		<a class="back-link" href="/blog">← Back to all essays</a>

		<article>
			<header class="essay-header">
				<p class="eyebrow">PERSONAL ESSAY</p>
				<h1 data-testid="blog-essay-title">{post.data.title}</h1>
				<div class="post-meta">
					<time datetime={post.data.pubDate.toISOString()}>
						{formatPostDate(post.data.pubDate)}
					</time>
					{
						post.data.updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<span>Updated {formatPostDate(post.data.updatedDate)}</span>
							</>
						)
					}
					<span aria-hidden="true">·</span>
					<span data-testid="blog-reading-time">{readingTime} min read</span>
				</div>
				<p class="description">{post.data.description}</p>
			</header>

			<div class="essay-content" data-testid="blog-essay-content">
				{post.id === 'thor-heyerdahl-journeys' && <HeyerdahlMap />}
				<Content />
			</div>
		</article>

		{
			post.data.relatedMapDataset && (
				<aside class="related-map">
					<p>Continue exploring the data behind this essay.</p>
					<a
						href={`/maps?dataset=${encodeURIComponent(post.data.relatedMapDataset)}`}
						data-track="blog-to-map-link"
						data-testid="blog-related-map-link"
					>
						Explore the interactive map
					</a>
				</aside>
			)
		}

		<a class="back-link bottom-link" href="/blog">← Back to all essays</a>
	</section>
</Layout>

<style>
	.essay-page {
		max-width: 65ch;
		margin: 0 auto;
		padding: 48px 0 80px;
	}

	.back-link {
		display: inline-block;
		color: var(--accent-muted);
		font-size: 0.9rem;
		text-decoration-color: var(--border-subtle);
		text-underline-offset: 3px;
	}

	.back-link:hover {
		color: var(--text-primary);
		text-decoration-color: var(--accent-muted);
	}

	.back-link:focus-visible {
		outline: 3px solid rgb(30 41 59 / 28%);
		outline-offset: 3px;
	}

	.essay-header {
		padding: 42px 0 30px;
		border-bottom: 1px solid var(--border-subtle);
	}

	.eyebrow {
		margin: 0 0 12px;
		color: var(--accent-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
			'Courier New', monospace;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	h1 {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		letter-spacing: -0.045em;
		line-height: 1.1;
		text-wrap: balance;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
		color: var(--accent-muted);
		font-size: 0.88rem;
	}

	.description {
		margin: 20px 0 0;
		color: var(--text-body);
		font-size: 1.08rem;
		line-height: 1.65;
	}

	.essay-content {
		padding: 30px 0 10px;
		color: var(--text-body);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.essay-content :global(p) {
		margin: 0 0 1.35em;
	}

	.essay-content :global(h2),
	.essay-content :global(h3) {
		margin: 1.8em 0 0.65em;
		color: var(--text-primary);
		line-height: 1.3;
	}

	.essay-content :global(a) {
		color: var(--accent);
		text-decoration-color: #94a3b8;
		text-underline-offset: 3px;
	}

	.essay-content :global(a:hover) {
		color: var(--accent-muted);
		text-decoration-color: var(--accent-muted);
	}

	.essay-content :global(blockquote) {
		margin: 1.6em 0;
		padding: 0.2em 0 0.2em 1.1em;
		border-left: 3px solid #94a3b8;
		color: var(--accent-muted);
	}

	.essay-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.related-map {
		margin-top: 30px;
		padding: 18px 20px;
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		background: #fff;
		color: var(--accent-muted);
		font-size: 0.92rem;
	}

	.related-map p {
		margin: 0 0 6px;
	}

	.related-map a {
		color: var(--accent);
		font-weight: 650;
		text-decoration-color: #94a3b8;
		text-underline-offset: 3px;
	}

	.bottom-link {
		margin-top: 28px;
	}

	@media (max-width: 700px) {
		.essay-page {
			padding: 36px 0 60px;
		}
	}
</style>
