---
import Layout from '../layouts/Layout.astro';
import LeafletMap from '../components/LeafletMap.astro';
---

<Layout title="Maps | Zlata Popelnuh">
	<section class="maps">
		<p class="eyebrow">Geospatial data</p>
		<h1>Maps</h1>
		<p class="description">Renewable energy share in gross final energy consumption, 2023.</p>

		<ul class="legend" aria-label="Renewable energy share legend">
			<li><span class="swatch no-data"></span>No data</li>
			<li><span class="swatch lowest"></span>&lt; 15%</li>
			<li><span class="swatch low"></span>15–24.9%</li>
			<li><span class="swatch medium"></span>25–39.9%</li>
			<li><span class="swatch high"></span>40–59.9%</li>
			<li><span class="swatch highest"></span>60%+</li>
		</ul>
		<p class="note">
			Source: <a href="https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/nrg_ind_ren">
				Eurostat nrg_ind_ren
			</a>. The UK value is an estimate; gray indicates countries without a value in this sample.
		</p>
		<p class="note boundary-note">
			Boundaries: <a href="https://gisco-services.ec.europa.eu/">Eurostat GISCO, 2024</a>.
			&copy; EuroGeographics for the administrative boundaries.
		</p>

		<LeafletMap />
	</section>
</Layout>

<style>
	.maps {
		padding: 64px 0 72px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #635bff;
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.description {
		margin: 16px 0 20px;
		color: #555b6b;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		margin: 0;
		padding: 0;
		color: #555b6b;
		font-size: 0.9rem;
		list-style: none;
	}

	.legend li {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.swatch {
		width: 14px;
		height: 14px;
		border: 1px solid rgba(23, 26, 36, 0.12);
		border-radius: 3px;
	}

	.lowest {
		background: #e6eceb;
	}

	.no-data {
		background: #e5e7eb;
	}

	.low {
		background: #bfd4d8;
	}

	.medium {
		background: #92bac8;
	}

	.high {
		background: #5f98b5;
	}

	.highest {
		background: #2f6f9f;
	}

	.note {
		margin: 14px 0 0;
		color: #6b7280;
		font-size: 0.88rem;
	}

	.boundary-note {
		margin: 6px 0 22px;
	}

	.note a {
		color: inherit;
	}
</style>
