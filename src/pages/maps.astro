---
import Layout from '../layouts/Layout.astro';
import LeafletMap from '../components/LeafletMap.astro';
import WorldTravelMap from '../components/WorldTravelMap.astro';
import { mapStrategies } from '../lib/mapStrategies';
---

<Layout title="Maps | Zlata Popelnuh">
	<section class="maps">
		<p class="eyebrow">Geospatial data</p>
		<h1>Maps</h1>
		<nav class="page-contents" aria-label="Page contents">
			<a
				href="#european-education-insights"
				data-track="maps-toc-link"
				data-testid="maps-toc-european-education-insights"
			>
				European Children Education Insights
			</a>
			<a
				href="#world-travel-map"
				data-track="maps-toc-link"
				data-testid="maps-toc-world-travel-map"
			>
				World Travel Map
			</a>
			<a
				href="#renewable-energy"
				data-track="maps-toc-link"
				data-testid="maps-toc-renewable-energy"
			>
				Renewable Energy
			</a>
		</nav>

		<section
			id="european-education-insights"
			aria-labelledby="european-education-insights-heading"
		>
			<h2 id="european-education-insights-heading" class="section-title">
				European Children Education Insights
			</h2>
			<div class="map-switcher" role="tablist" aria-label="Map datasets">
				<button
					id="childcare-tab"
					class="map-tab active"
					type="button"
					role="tab"
					aria-selected="true"
					tabindex="0"
					aria-controls="map-panel"
					data-map-strategy="childcare"
					data-track="map-tab-switch"
					data-dataset="childcare"
					data-testid="map-tab-childcare"
				>
					Childcare Costs
				</button>
				<button
					id="school-uniforms-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="school-uniforms"
					data-track="map-tab-switch"
					data-dataset="school-uniforms"
					data-testid="map-tab-school-uniforms"
				>
					School Uniforms
				</button>
				<button
					id="free-school-meals-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="free-school-meals"
					data-track="map-tab-switch"
					data-dataset="free-school-meals"
					data-testid="map-tab-free-school-meals"
				>
					Free School Meals
				</button>
				<button
					id="summer-holidays-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="summer-holidays"
					data-track="map-tab-switch"
					data-dataset="summer-holidays"
					data-testid="map-tab-summer-holidays"
				>
					Summer Holidays
				</button>
				<button
					id="school-starting-age-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="school-starting-age"
					data-track="map-tab-switch"
					data-dataset="school-starting-age"
					data-testid="map-tab-school-starting-age"
				>
					School Starting Age
				</button>
				<button
					id="teacher-qualifications-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="teacher-qualifications"
					data-track="map-tab-switch"
					data-dataset="teacher-qualifications"
					data-testid="map-tab-teacher-qualifications"
				>
					Teacher Qualifications
				</button>
				<button
					id="religious-education-tab"
					class="map-tab"
					type="button"
					role="tab"
					aria-selected="false"
					tabindex="-1"
					aria-controls="map-panel"
					data-map-strategy="religious-education"
					data-track="map-tab-switch"
					data-dataset="religious-education"
					data-testid="map-tab-religious-education"
				>
					Religion in Schools
				</button>
			</div>

			<div id="map-panel" role="tabpanel" aria-labelledby="childcare-tab">
				<h2 id="metric-title">{mapStrategies.childcare.title}</h2>
				<ul class="legend" id="metric-legend" aria-label={mapStrategies.childcare.legendLabel}>
					{
						mapStrategies.childcare.legendIntervals.map((item) => (
							<li>
								<span
									class="swatch"
									style={`background-color: ${item.color}`}
									data-testid="map-legend-swatch"
								></span>
								{item.label}
							</li>
						))
					}
				</ul>
				<LeafletMap initialStrategy="childcare" />

				<div class="metadata-bar">
					<p class="description" id="metric-description">
						{mapStrategies.childcare.description}
					</p>
					<div class="source-details">
						<p class="note">
							Source: <a
								id="source-link"
								href={mapStrategies.childcare.sourceUrl}
								data-track="map-source-link"
								data-testid="map-source-link"
							>
								{mapStrategies.childcare.sourceLabel}
							</a>.{' '}
							<span id="source-detail">{mapStrategies.childcare.sourceDetail}</span>
						</p>
						<p class="note boundary-note">
							Boundaries: <a href="https://gisco-services.ec.europa.eu/">Eurostat GISCO, 2024</a>.
							&copy; EuroGeographics for the administrative boundaries.
						</p>
					</div>
				</div>
			</div>
		</section>

		<WorldTravelMap />

		<section id="renewable-energy" aria-labelledby="renewable-energy-heading">
			<h2 id="renewable-energy-heading" class="section-title">Renewable Energy</h2>
			<ul
				class="legend"
				id="renewable-energy-legend"
				aria-label={mapStrategies.renewable.legendLabel}
			>
				{
					mapStrategies.renewable.legendIntervals.map((item) => (
						<li>
							<span
								class="swatch"
								style={`background-color: ${item.color}`}
								data-testid="renewable-map-legend-swatch"
							></span>
							{item.label}
						</li>
					))
				}
			</ul>
			<LeafletMap initialStrategy="renewable" />
			<div class="metadata-bar">
				<p class="description">{mapStrategies.renewable.description}</p>
				<div class="source-details">
					<p class="note">
						Source: <a
							href={mapStrategies.renewable.sourceUrl}
							data-track="map-source-link"
							data-testid="renewable-map-source-link"
						>
							{mapStrategies.renewable.sourceLabel}
						</a>.{' '}
						<span>{mapStrategies.renewable.sourceDetail}</span>
					</p>
					<p class="note boundary-note">
						Boundaries: <a href="https://gisco-services.ec.europa.eu/">Eurostat GISCO, 2024</a>.
						&copy; EuroGeographics for the administrative boundaries.
					</p>
				</div>
			</div>
		</section>
	</section>
</Layout>

<script>
	import { mapStrategies, type MapStrategyKey } from '../lib/mapStrategies';
	import { selectCategoricalPolicyDataset } from '../lib/mapRepository';
	import { buildDatasetUrl, resolveDatasetFromSearch } from '../lib/urlState';

	const datasetTabList = document.querySelector<HTMLDivElement>(
		'[role="tablist"][aria-label="Map datasets"]',
	);
	const tabs = datasetTabList
		? Array.from(
				datasetTabList.querySelectorAll<HTMLButtonElement>(
					'button[role="tab"][data-dataset]',
				),
			)
		: [];
	const datasetKeys = tabs.map((tab) => tab.dataset.dataset).filter(isMapStrategyKey);
	const title = document.querySelector<HTMLElement>('#metric-title');
	const description = document.querySelector<HTMLElement>('#metric-description');
	const legend = document.querySelector<HTMLUListElement>('#metric-legend');
	const sourceLink = document.querySelector<HTMLAnchorElement>('#source-link');
	const sourceDetail = document.querySelector<HTMLElement>('#source-detail');
	const panel = document.querySelector<HTMLElement>('#map-panel');
	const map = document.querySelector<HTMLElement>('[data-testid="leaflet-map"]');
	let selectedStrategyKey: MapStrategyKey = 'childcare';

	if (map) {
		new MutationObserver(() => {
			const ariaLabel = mapStrategies[selectedStrategyKey].ariaLabel;
			if (map.getAttribute('aria-label') !== ariaLabel) {
				map.setAttribute('aria-label', ariaLabel);
			}
		}).observe(map, { attributes: true, attributeFilter: ['aria-label'] });
	}

	function isMapStrategyKey(value: string | undefined): value is MapStrategyKey {
		return (
			value === 'childcare' ||
			value === 'school-uniforms' ||
			value === 'free-school-meals' ||
			value === 'summer-holidays' ||
			value === 'school-starting-age' ||
			value === 'teacher-qualifications' ||
			value === 'religious-education'
		);
	}

	function selectStrategy(key: MapStrategyKey, updateUrl = false): void {
		const strategy = mapStrategies[key];
		if (!title || !description || !legend || !sourceLink || !sourceDetail || !panel || !map) return;
		selectedStrategyKey = key;

		title.textContent = strategy.title;
		description.textContent = strategy.description;
		legend.setAttribute('aria-label', strategy.legendLabel);
		legend.replaceChildren(
			...strategy.legendIntervals.map((item) => {
				const entry = document.createElement('li');
				const swatch = document.createElement('span');
				swatch.className = 'swatch';
				swatch.style.backgroundColor = item.color;
				swatch.dataset.testid = 'map-legend-swatch';
				entry.append(swatch, document.createTextNode(item.label));
				return entry;
			}),
		);
		sourceLink.href = strategy.sourceUrl;
		sourceLink.textContent = strategy.sourceLabel;
		sourceDetail.textContent = strategy.sourceDetail;
		panel.setAttribute('aria-labelledby', `${key}-tab`);
		map.setAttribute('aria-label', strategy.ariaLabel);

		for (const tab of tabs) {
			const selected = tab.dataset.dataset === key;
			tab.setAttribute('aria-selected', String(selected));
			tab.setAttribute('tabindex', selected ? '0' : '-1');
			tab.classList.toggle('active', selected);
		}

		if (updateUrl) {
			window.history.replaceState(null, '', buildDatasetUrl(window.location.href, key));
		}

		const rendererStrategyKey =
			key === 'free-school-meals' ? 'school-uniforms' : key;
		if (
			key === 'free-school-meals' ||
			key === 'school-uniforms' ||
			key === 'teacher-qualifications' ||
			key === 'religious-education'
		) {
			selectCategoricalPolicyDataset(key);
		}
		map.dispatchEvent(
			new CustomEvent('map:strategy-change', { detail: rendererStrategyKey }),
		);
		if (key === 'free-school-meals') {
			const status = map.parentElement?.querySelector<HTMLElement>('[role="status"]');
			if (status) status.textContent = `Loading ${strategy.title.toLowerCase()} map…`;
		}
	}

	for (const tab of tabs) {
		tab.addEventListener('click', () => {
			const key = tab.dataset.dataset;
			if (isMapStrategyKey(key)) selectStrategy(key, true);
		});
		tab.addEventListener('keydown', (event) => {
			const currentIndex = tabs.indexOf(tab);
			let nextIndex: number | undefined;

			if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
			if (event.key === 'ArrowLeft') nextIndex = (currentIndex + tabs.length - 1) % tabs.length;
			if (event.key === 'Home') nextIndex = 0;
			if (event.key === 'End') nextIndex = tabs.length - 1;
			if (nextIndex === undefined) return;

			event.preventDefault();
			const nextTab = tabs[nextIndex];
			nextTab?.focus();
			const key = nextTab?.dataset.dataset;
			if (isMapStrategyKey(key)) selectStrategy(key, true);
		});
	}

	const defaultDatasetKey = tabs[0]?.dataset.dataset;
	if (defaultDatasetKey && isMapStrategyKey(defaultDatasetKey)) {
		const initialDatasetKey = resolveDatasetFromSearch(
			window.location.search,
			datasetKeys,
			defaultDatasetKey,
		);
		if (isMapStrategyKey(initialDatasetKey)) selectStrategy(initialDatasetKey);
	}
</script>

<style>
	.maps {
		padding: 64px 0 72px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent-muted);
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		letter-spacing: -0.05em;
		line-height: 1;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	.page-contents {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
		margin: 16px 0 34px;
		font-size: 0.9rem;
	}

	.page-contents a {
		color: var(--accent-muted);
		text-decoration-color: var(--border-subtle);
		text-underline-offset: 3px;
	}

	.page-contents a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.page-contents a:focus-visible {
		outline: 3px solid rgb(30 41 59 / 28%);
		outline-offset: 3px;
	}

	#european-education-insights,
	#renewable-energy {
		scroll-margin-top: 24px;
	}

	.section-title {
		margin: 0 0 14px;
		color: var(--text-primary);
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.map-switcher {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 28px 0 24px;
	}

	.map-tab {
		border: 1px solid var(--border-subtle);
		border-radius: 999px;
		padding: 9px 16px;
		background: #fff;
		color: var(--text-body);
		font: inherit;
		font-size: 0.92rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.map-tab:hover,
	.map-tab.active {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent);
	}

	.map-tab:focus-visible {
		outline: 3px solid rgb(30 41 59 / 28%);
		outline-offset: 2px;
	}

	h2 {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		letter-spacing: -0.03em;
	}

	.description {
		margin: 0;
		color: var(--text-body);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.metadata-bar {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 1fr);
		gap: 18px 28px;
		margin-top: 16px;
		padding: 16px 18px;
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		background: #fff;
	}

	.source-details {
		display: grid;
		gap: 8px;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		margin: 0;
		padding: 0;
		color: var(--text-body);
		font-size: 0.9rem;
		list-style: none;
	}

	.legend :global(li) {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.legend :global(.swatch) {
		display: inline-block;
		flex: 0 0 14px;
		width: 14px;
		height: 14px;
		border: 1px solid var(--border-subtle);
		border-radius: 3px;
	}

	.note {
		margin: 14px 0 0;
		color: var(--accent-muted);
		font-size: 0.88rem;
	}

	.boundary-note {
		margin: 0;
	}

	.note a {
		color: inherit;
	}

	@media (max-width: 700px) {
		.metadata-bar {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
	}
</style>
