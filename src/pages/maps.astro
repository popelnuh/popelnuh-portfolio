---
import Layout from '../layouts/Layout.astro';
import LeafletMap from '../components/LeafletMap.astro';
---

<Layout title="Maps | Zlata Popelnuh">
	<section class="maps">
		<p class="eyebrow">Geospatial data</p>
		<h1>Maps</h1>
		<p class="description">A sample choropleth using illustrative renewable energy values.</p>

		<ul class="legend" aria-label="Renewable energy share legend">
			<li><span class="swatch lowest"></span>&lt; 17%</li>
			<li><span class="swatch low"></span>17–18.9%</li>
			<li><span class="swatch medium"></span>19–20.9%</li>
			<li><span class="swatch high"></span>21–22.9%</li>
			<li><span class="swatch highest"></span>23%+</li>
		</ul>
		<p class="note">Values are illustrative sample data, not official Eurostat statistics.</p>

		<LeafletMap />
	</section>
</Layout>

<style>
	.maps {
		padding: 64px 0 72px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #635bff;
		font-size: 0.85rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.description {
		margin: 16px 0 20px;
		color: #555b6b;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		margin: 0;
		padding: 0;
		color: #555b6b;
		font-size: 0.9rem;
		list-style: none;
	}

	.legend li {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.swatch {
		width: 14px;
		height: 14px;
		border: 1px solid rgba(23, 26, 36, 0.12);
		border-radius: 3px;
	}

	.lowest {
		background: #e6eceb;
	}

	.low {
		background: #bfd4d8;
	}

	.medium {
		background: #92bac8;
	}

	.high {
		background: #5f98b5;
	}

	.highest {
		background: #2f6f9f;
	}

	.note {
		margin: 14px 0 22px;
		color: #6b7280;
		font-size: 0.88rem;
	}
</style>
